<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- C4 FIX: Đã xóa AutoMapper - Domain không được phụ thuộc vào mapping framework -->
    <!-- MediatR được giữ lại vì INotification dùng cho Domain Events (DDD pattern) -->
    <!-- Nếu muốn hoàn toàn tách biệt: tạo IDomainEvent interface riêng trong Domain -->
    <!-- và chuyển sang INotification ở Application layer -->
    <PackageReference Include="HtmlSanitizer" Version="9.0.892" />
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.10" />
  </ItemGroup>

</Project>
