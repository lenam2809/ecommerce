{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=EcommerceDb;Trusted_Connection=true;TrustServerCertificate=true;",
    "Redis": "localhost:6379"
  },
  "Auth": {
    "TokenHashSecret": "your-token-hash-secret-key-here"
  },
  "Jwt": {
    "Key": "your-jwt-key-here-must-be-at-least-32-characters-long",
    "Issuer": "https://yourdomain.com",
    "Audience": "https://yourdomain.com",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://yourdomain.com"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "ImportantInformationEventNames": [
      "BusinessActionRequest"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },
  "RequestLogging": {
    "CorrelationIdHeaderName": "X-Correlation-ID",
    "LogSuccessfulRequests": true,
    "NoisySuccessSamplingRules": [
      {
        "Method": "GET",
        "PathPrefix": "/api/Products",
        "SuccessSampleRate": 0.1
      },
      {
        "Method": "GET",
        "PathPrefix": "/api/Categories/paged",
        "SuccessSampleRate": 0.1
      },
      {
        "Method": "GET",
        "PathPrefix": "/api/Brands/paged",
        "SuccessSampleRate": 0.1
      },
      {
        "Method": "GET",
        "PathPrefix": "/api/SearchSuggestions",
        "SuccessSampleRate": 0.1
      }
    ],
    "ImportantInformationRules": [
      {
        "Method": "POST",
        "PathPrefix": "/api/Orders"
      },
      {
        "Method": "POST",
        "PathPrefix": "/api/Payments/vnpay/create-url"
      }
    ]
  },
  "Redis": {
    "Configuration": "localhost:6379"
  },
  "Email": {
    "SmtpServer": "smtp.your-email-provider.com",
    "Port": 587,
    "SenderEmail": "noreply@yourdomain.com",
    "SenderName": "Ecommerce System",
    "Username": "your-smtp-username",
    "Password": "your-app-password"
  },
  "Stripe": {
    "SecretKey": "sk_test_your_stripe_secret_key",
    "PublishableKey": "pk_test_your_stripe_publishable_key",
    "WebhookSecret": "whsec_your_webhook_secret"
  }
}
