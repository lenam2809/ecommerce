{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=EcommerceDb;Trusted_Connection=true;TrustServerCertificate=true;",
    "Redis": "localhost:6379"
  },
  "Auth": {
    "TokenHashSecret": "your-token-hash-secret-key-here"
  },
  "Jwt": {
    "Key": "your-jwt-key-here-must-be-at-least-32-characters-long",
    "Issuer": "https://yourdomain.com",
    "Audience": "https://yourdomain.com",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://yourdomain.com"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "ImportantInformationEventNames": [
      "BusinessActionRequest"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },
  "RequestLogging": {
    "CorrelationIdHeaderName": "X-Correlation-ID",
    "LogSuccessfulRequests": true,
    "NoisySuccessSamplingRules": [
      {
        "Method": "GET",
        "PathPrefix": "/api/Products",
        "SuccessSampleRate": 0.1
      },
      {
        "Method": "GET",
        "PathPrefix": "/api/Categories/paged",
        "SuccessSampleRate": 0.1
      },
      {
        "Method": "GET",
        "PathPrefix": "/api/Brands/paged",
        "SuccessSampleRate": 0.1
      },
      {
        "Method": "GET",
        "PathPrefix": "/api/SearchSuggestions",
        "SuccessSampleRate": 0.1
      }
    ],
    "ImportantInformationRules": [
      {
        "Method": "POST",
        "PathPrefix": "/api/Orders"
      },
      {
        "Method": "POST",
        "PathPrefix": "/api/Payments/vnpay/create-url"
      }
    ]
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "ecommerce:"
  },
  "CacheSettings": {
    "UseRedis": true,
    "RedisConnection": "localhost:6379",
    "InstanceName": "ecommerce:",
    "DefaultExpirationMinutes": 10,
    "DefaultSlidingExpirationMinutes": 2,
    "ProductExpirationMinutes": 10,
    "CategoryExpirationMinutes": 30,
    "BrandExpirationMinutes": 30,
    "ConfigExpirationMinutes": 60,
    "UserSpecificExpirationMinutes": 2,
    "GuestCartExpirationDays": 7
  },
  "Elasticsearch": {
    "UseElasticsearch": true,
    "Uri": "http://localhost:9200",
    "DefaultIndex": "products",
    "Username": "",
    "Password": "",
    "EnableSsl": false,
    "RunStartupReindex": true,
    "RunDailyReindex": true,
    "DailyReindexHourUtc": 19
  },
  "Email": {
    "FromAddress": "noreply@yourdomain.com",
    "FromName": "ShopViet",
    "Smtp": {
      "Host": "smtp.your-email-provider.com",
      "Port": 587,
      "Username": "your-smtp-username",
      "Password": "your-app-password",
      "EnableSsl": true
    }
  },
  "Authentication": {
    "Google": {
      "ClientId": "your-google-client-id",
      "ClientSecret": "your-google-client-secret",
      "CallbackUrl": "https://your-frontend-domain.com/api/auth/google-oauth-callback"
    }
  },
  "AppUrl": {
    "Frontend": "https://your-frontend-domain.com"
  },
  "Stripe": {
    "SecretKey": "sk_test_your_stripe_secret_key",
    "PublishableKey": "pk_test_your_stripe_publishable_key",
    "WebhookSecret": "whsec_your_webhook_secret"
  }
}
