{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FileStorage": {
    "AppUrl": "",
    "UploadFolder": "uploads"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ecommerce_db;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_MINIMUM_32_CHARACTERS",
    "Issuer": "Ecommerce",
    "Audience": "EcommerceUsers",
    "AccessTokenExpirationMinutes": 60
  },
  "VnPay": {
    "TmnCode": "CHANGE_ME",
    "HashSecret": "CHANGE_ME",
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "ReturnUrl": "http://localhost:3000/payment/vnpay-return",
    "Version": "2.1.0"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "http://localhost:3001"
    ]
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "IndexName": "shopviet-products",
    "EnableSsl": false
  },
  "AllowedHosts": "*"
}
