{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ecommerce_db;Username=postgres;Password=your_postgres_password;",
    "Redis": "localhost:6379"
  },
  "Auth": {
    "TokenHashSecret": "CHANGE_ME_SEPARATE_TOKEN_HASH_SECRET_MIN_32_CHARS"
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_MINIMUM_32_CHARACTERS",
    "Issuer": "Ecommerce",
    "Audience": "EcommerceUsers",
    "AccessTokenExpirationMinutes": 60
  },
  "AuthConfig": {
    "UseCookieAuth": true,
    "AllowHeaderFallback": true,
    "EnableCsrfProtection": true,
    "IncludeTokensInResponse": true
  },
  "CookieSettings": {
    "ForceSecure": false,
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "Domain": null
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "https://yourdomain.com"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "ImportantInformationEventNames": [
      "BusinessActionRequest"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },
  "RequestLogging": {
    "CorrelationIdHeaderName": "X-Correlation-ID",
    "LogSuccessfulRequests": true,
    "NoisySuccessSamplingRules": [
      {
        "Method": "GET",
        "PathPrefix": "/api/Products",
        "SuccessSampleRate": 0.1
      },
      {
        "Method": "GET",
        "PathPrefix": "/api/Categories/paged",
        "SuccessSampleRate": 0.1
      },
      {
        "Method": "GET",
        "PathPrefix": "/api/Brands/paged",
        "SuccessSampleRate": 0.1
      },
      {
        "Method": "GET",
        "PathPrefix": "/api/SearchSuggestions",
        "SuccessSampleRate": 0.1
      }
    ],
    "ImportantInformationRules": [
      {
        "Method": "POST",
        "PathPrefix": "/api/Orders"
      },
      {
        "Method": "POST",
        "PathPrefix": "/api/Payments/vnpay/create-url"
      }
    ]
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "ecommerce:"
  },
  "CacheSettings": {
    "UseRedis": true,
    "RedisConnection": "localhost:6379",
    "InstanceName": "ecommerce:",
    "DefaultExpirationMinutes": 10,
    "DefaultSlidingExpirationMinutes": 2,
    "ProductExpirationMinutes": 10,
    "CategoryExpirationMinutes": 30,
    "BrandExpirationMinutes": 30,
    "ConfigExpirationMinutes": 60,
    "UserSpecificExpirationMinutes": 2,
    "GuestCartExpirationDays": 7
  },
  "Elasticsearch": {
    "UseElasticsearch": true,
    "Uri": "http://localhost:9200",
    "DefaultIndex": "products",
    "Username": "",
    "Password": "",
    "EnableSsl": false,
    "RunStartupReindex": true,
    "RunDailyReindex": true,
    "DailyReindexHourUtc": 19
  },
  "Email": {
    "FromAddress": "noreply@yourdomain.com",
    "FromName": "ShopViet",
    "Smtp": {
      "Host": "smtp.your-email-provider.com",
      "Port": 587,
      "Username": "your-smtp-username",
      "Password": "your-app-password",
      "EnableSsl": true
    }
  },
  "Authentication": {
    "Google": {
      "ClientId": "your-google-client-id",
      "ClientSecret": "your-google-client-secret",
      "CallbackUrl": "https://your-frontend-domain.com/api/auth/google-oauth-callback"
    }
  },
  "AppUrl": {
    "Frontend": "https://your-frontend-domain.com"
  },
  "VnPay": {
    "TmnCode": "your_vnpay_tmn_code",
    "HashSecret": "your_vnpay_hash_secret",
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "ReturnUrl": "http://localhost:5000/api/payments/vnpay/return",
    "Version": "2.1.0"
  }
}
