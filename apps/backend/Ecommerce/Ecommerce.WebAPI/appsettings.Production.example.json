{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AppUrl": "http://localhost:6262",
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ecommerce_db;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_MINIMUM_32_CHARACTERS",
    "Issuer": "https://localhost:7236",
    "Audience": "https://localhost:7236",
    "AccessTokenExpirationMinutes": 60
  },
  "CacheSettings": {
    "UseRedis": false,
    "RedisConnection": "localhost:6379",
    "DefaultExpirationMinutes": 60,
    "UserCacheDuration": 10,
    "RoleCacheDuration": 30,
    "PermissionCacheDuration": 60,
    "ConfigCacheDuration": 120,
    "EntityCacheDuration": 15
  },
  "FileStorage": {
    "UploadFolder": "uploads",
    "AppUrl": "http://localhost:6262"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "ImportantInformationEventNames": [
      "BusinessActionRequest"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },
  "RequestLogging": {
    "CorrelationIdHeaderName": "X-Correlation-ID",
    "LogSuccessfulRequests": false,
    "NoisySuccessSamplingRules": [
      {
        "Method": "GET",
        "PathPrefix": "/api/Products",
        "SuccessSampleRate": 0.01
      },
      {
        "Method": "GET",
        "PathPrefix": "/api/Categories/paged",
        "SuccessSampleRate": 0.01
      },
      {
        "Method": "GET",
        "PathPrefix": "/api/Brands/paged",
        "SuccessSampleRate": 0.01
      },
      {
        "Method": "GET",
        "PathPrefix": "/api/SearchSuggestions",
        "SuccessSampleRate": 0.01
      }
    ],
    "ImportantInformationRules": [
      {
        "Method": "POST",
        "PathPrefix": "/api/Orders"
      },
      {
        "Method": "POST",
        "PathPrefix": "/api/Payments/vnpay/create-url"
      }
    ]
  },
  "AuthConfig": {
    "UseCookieAuth": true,
    "AllowHeaderFallback": false,
    "EnableCsrfProtection": true,
    "IncludeTokensInResponse": false
  },
  "CookieSettings": {
    "ForceSecure": true,
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "Domain": null
  }
}
