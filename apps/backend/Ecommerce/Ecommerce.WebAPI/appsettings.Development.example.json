{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FileStorage": {
    "AppUrl": "http://localhost:5000",
    "UploadFolder": "uploads"
  },
  "AppUrl": "http://localhost:5000",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ecommerce_db;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_MINIMUM_32_CHARACTERS",
    "Issuer": "Ecommerce",
    "Audience": "EcommerceUsers",
    "AccessTokenExpirationMinutes": 60
  },
  "CacheSettings": {
    "UseRedis": true,
    "RedisConnection": "localhost:6379",
    "InstanceName": "ecommerce:",
    "DefaultExpirationMinutes": 10,
    "DefaultSlidingExpirationMinutes": 2,
    "ProductExpirationMinutes": 10,
    "CategoryExpirationMinutes": 30,
    "BrandExpirationMinutes": 30,
    "ConfigExpirationMinutes": 60,
    "UserSpecificExpirationMinutes": 2,
    "GuestCartExpirationDays": 7,
    "UserCacheDuration": 10,
    "RoleCacheDuration": 30,
    "PermissionCacheDuration": 60,
    "ConfigCacheDuration": 120,
    "EntityCacheDuration": 15
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "ecommerce:"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "ImportantInformationEventNames": [
      "BusinessActionRequest"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },
  "RequestLogging": {
    "CorrelationIdHeaderName": "X-Correlation-ID",
    "LogSuccessfulRequests": true,
    "NoisySuccessSamplingRules": [
      {
        "Method": "GET",
        "PathPrefix": "/api/Products",
        "SuccessSampleRate": 0.1
      },
      {
        "Method": "GET",
        "PathPrefix": "/api/Categories/paged",
        "SuccessSampleRate": 0.1
      },
      {
        "Method": "GET",
        "PathPrefix": "/api/Brands/paged",
        "SuccessSampleRate": 0.1
      },
      {
        "Method": "GET",
        "PathPrefix": "/api/SearchSuggestions",
        "SuccessSampleRate": 0.1
      }
    ],
    "ImportantInformationRules": [
      {
        "Method": "POST",
        "PathPrefix": "/api/Orders"
      },
      {
        "Method": "POST",
        "PathPrefix": "/api/Payments/vnpay/create-url"
      }
    ]
  },
  "AuthConfig": {
    "UseCookieAuth": true,
    "AllowHeaderFallback": true,
    "EnableCsrfProtection": true,
    "IncludeTokensInResponse": true
  },
  "CookieSettings": {
    "ForceSecure": false,
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "Domain": null
  }
}
