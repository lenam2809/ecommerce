        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "displayMode": "gradient",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "orientation": "horizontal",
        "showValue": "auto"
      },
      "targets": [
        {
          "expr": "topk(5, sum by (route) (rate(ecommerce_http_request_duration_ms_sum[5m])) / clamp_min(sum by (route) (rate(ecommerce_http_request_duration_ms_count[5m])), 1))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "title": "Top 5 Slowest Endpoints",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "displayMode": "gradient",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "orientation": "horizontal",
        "showValue": "auto"
      },
      "targets": [
        {
          "expr": "topk(5, sum by (route, status_code) (increase(ecommerce_http_request_errors_total[1h])))",
          "legendFormat": "{{status_code}} {{route}}",
          "refId": "A"
        }
      ],
      "title": "Top 5 Error Types",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
