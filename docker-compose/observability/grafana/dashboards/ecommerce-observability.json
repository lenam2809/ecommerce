        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(ecommerce_http_requests_total[1m]))",
          "legendFormat": "requests/sec",
          "refId": "A"
        }
