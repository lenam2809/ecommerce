# =============================================================================
# Ecommerce Docker Environment Variables (11 Services Stack)
# =============================================================================
# Copy this file to .env and replace placeholder values before running locally.
# Do not commit the resulting .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL 15/16)
# -----------------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=ecommerce_db
DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=ecommerce_db;Username=postgres;Password=yourpassword;

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_CONNECTION_STRING=redis:6379
REDIS_INSTANCE_NAME=ecommerce:
USE_REDIS=true
CACHE_DEFAULT_EXPIRATION_MINUTES=60
CACHE_PRODUCT_EXPIRATION_MINUTES=10
CACHE_CATEGORY_EXPIRATION_MINUTES=30
CACHE_BRAND_EXPIRATION_MINUTES=30
CACHE_GUEST_CART_EXPIRATION_DAYS=7
CACHE_USER_DURATION=10
CACHE_ROLE_DURATION=30
CACHE_PERMISSION_DURATION=60
CACHE_CONFIG_DURATION=120
CACHE_ENTITY_DURATION=15

# -----------------------------------------------------------------------------
# RabbitMQ Configuration
# -----------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# -----------------------------------------------------------------------------
# Elasticsearch Configuration (Search Service)
# -----------------------------------------------------------------------------
ELASTICSEARCH_DEFAULT_INDEX=products
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# -----------------------------------------------------------------------------
# Observability Configuration (Jaeger, Prometheus, Alertmanager, Grafana)
# -----------------------------------------------------------------------------
APP_VERSION=1.0.0
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Logging Configuration (Serilog)
# -----------------------------------------------------------------------------
LOG_LEVEL_DEFAULT=Information
LOG_LEVEL_MICROSOFT=Warning
LOG_LEVEL_SYSTEM=Warning
LOG_RETENTION_INFORMATION_DAYS=14
LOG_RETENTION_ERROR_DAYS=90
LOG_RETENTION_PERFORMANCE_DAYS=30

FILE_STORAGE_APP_URL=
FILE_STORAGE_UPLOAD_FOLDER=uploads

# -----------------------------------------------------------------------------
# Backend API Configuration
# -----------------------------------------------------------------------------
BACKEND_PORT=5000
BACKEND_URL=http://localhost:5000
ASPNETCORE_ENVIRONMENT=Production
SEED_ENABLED=true
SEED_SAMPLE_DATA=true

# -----------------------------------------------------------------------------
# JWT & Auth Configuration
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_MINIMUM_32_CHARACTERS
JWT_ISSUER=Ecommerce
JWT_AUDIENCE=EcommerceUsers
JWT_EXPIRATION=60
AUTH_TOKEN_HASH_SECRET=CHANGE_ME_SEPARATE_TOKEN_HASH_SECRET_MIN_32_CHARS

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
CLIENT_PORT=3000
DASHBOARD_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:5000/api
FRONTEND_URL_1=http://localhost:3000
FRONTEND_URL_2=http://localhost:3001
