# =============================================================================
# Ecommerce Docker Environment Variables
# =============================================================================
# Copy this file to .env and replace placeholder values before running locally.
# Do not commit the resulting .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DB_CONNECTION_STRING=Server=host.docker.internal;Database=ecommerce_db;User Id=CHANGE_ME;Password=CHANGE_ME;TrustServerCertificate=True;MultipleActiveResultSets=True;

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_CONNECTION_STRING=redis:6379
USE_REDIS=false
CACHE_DEFAULT_EXPIRATION_MINUTES=60
CACHE_USER_DURATION=10
CACHE_ROLE_DURATION=30
CACHE_PERMISSION_DURATION=60
CACHE_CONFIG_DURATION=120
CACHE_ENTITY_DURATION=15

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL_DEFAULT=Information
LOG_LEVEL_MICROSOFT=Warning
LOG_LEVEL_SYSTEM=Warning

FILE_STORAGE_APP_URL=
FILE_STORAGE_UPLOAD_FOLDER=uploads

# -----------------------------------------------------------------------------
# Backend API Configuration
# -----------------------------------------------------------------------------
BACKEND_PORT=5000
BACKEND_URL=http://localhost:5000
ASPNETCORE_ENVIRONMENT=Production

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_MINIMUM_32_CHARACTERS
JWT_ISSUER=Ecommerce
JWT_AUDIENCE=EcommerceUsers
JWT_EXPIRATION=60

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
CLIENT_PORT=3000
DASHBOARD_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:5000/api
